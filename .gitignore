# NextHyke Git Ignore Rules

# Python Embedded Runtime & Virtual Environments
runtime/
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build Outputs & Packaging
dist/
out/
build/
*.exe
!tools/*.ps1
!tools/*.py

# AI Model Weights & Checkpoints (Heavy Binaries)
models/*.onnx
models/*.pt
models/*.bin
models/*.safetensors
models/*.engine

# Native C++ Compilation Artifacts
*.obj
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.suo
*.user
x64/
x86/
Debug/
Release/

# Logs & Diagnostics
*.log
scratch/
temp/
*.tmp

# Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
